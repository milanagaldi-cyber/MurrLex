[Unit]
Description=Od Pani Ewy private shop preview
After=network.target

[Service]
Type=simple
User=odpaniewy
Group=www-data
WorkingDirectory=/opt/odpaniewy/current
ExecStart=/opt/odpaniewy/runtime/bin/node server.mjs
Environment=NODE_ENV=production
Environment=ODP_ACCESS=vpn-socket
Environment=ODP_BASE=/
Environment=ODP_SOCKET=/run/odpaniewy/app.sock
Environment=ODP_ORIGIN=https://ml-staging-api.lexaailabs.com:8445
Environment=ODP_ASSETS=/var/lib/odpaniewy/media
RuntimeDirectory=odpaniewy
RuntimeDirectoryMode=0750
UMask=0117
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/odpaniewy
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=48

[Install]
WantedBy=multi-user.target
