#!/usr/bin/env bash
set -Eeuo pipefail

read -r command mode extra <<<"${SSH_ORIGINAL_COMMAND:-}"

if [[ "${command}" != "deploy" ]] || [[ -n "${extra:-}" ]]; then
  echo "This SSH key only accepts: ssh USER@HOST 'deploy fast-ui|backend|full'" >&2
  exit 1
fi

case "${mode:-}" in
  fast-ui|backend|full)
    exec sudo -n /usr/local/sbin/murrlex-deploy "${mode}"
    ;;
  *)
    echo "Deployment mode must be one of: fast-ui, backend, full." >&2
    exit 1
    ;;
esac
